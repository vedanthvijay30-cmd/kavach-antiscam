[app]
title = KavachShield
package.name = kavachshield
package.domain = org.antiscam
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy,urllib3
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,CALL_PHONE,READ_PHONE_STATE,RECEIVE_SMS

[buildozer]
log_level = 2
warn_on_root = 1
